# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
TAVILY_API_KEY=
MP_API_KEY=
# Optional: pin model ids printed by check_setup.py
AGENT_MODEL=
FAST_MODEL=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Credit guard: no new model calls once this many tokens are spent. The ledger is in data/cache/llm; do not delete it.
TOKEN_BUDGET=2000000
# Hard limit in our code: a model call is refused if its worst case would pass this. Our code only: check the real
# balance on Token Factory too, and never share the key.
SPEND_LIMIT_USD=20
# Prices behind the limit (USD per million tokens). Set them from the model's real price before long runs.
PRICE_IN_PER_M=1.0
PRICE_OUT_PER_M=3.0
# Phone-call supervisor via CALL-E (optional): the watcher phones a human before risky steps.
CALLE_API_KEY=
CALLE_ALLOWED_NUMBERS=
SUPERVISOR_PHONE=
CALLE_MAX_CALLS=4
# 1 = log only, no real call. 0 = real calls (spends credit)
DRY_RUN=1
# Set to 1 on a hosted demo: read-only, shows no machine details
CATHODEPILOT_PUBLIC=0
